# GCP credentials (local Terraform / ADC)
GOOGLE_APPLICATION_CREDENTIALS=./samplecode3.json
# Used by GitHub Actions deploy job (repository secret)
# GCP_PROJECT_ID=your-gcp-project-id

# Cloudflare (Terraform: set TF_VAR_manage_cloudflare_dns=true to create DNS)
CLOUDFLARE_API_TOKEN="cloudflare_api_token"
# TF_VAR_manage_cloudflare_dns=true
# TF_VAR_cloudflare_zone_name=francojim.com

